# Public HTTPS origin used to generate sitemap URLs
SITE_URL=https://www.example.com

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Host port exposed by Docker Compose
PORT=3000

# Required for Vercel serverless submissions. Add these through the Vercel
# Upstash Marketplace integration or deployment environment; never commit secrets.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
