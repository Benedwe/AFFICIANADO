{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/pillars", "destination": "/index.html" },
    { "source": "/team", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/experiences", "destination": "/index.html" },
    { "source": "/opportunities", "destination": "/index.html" },
    { "source": "/community", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/partnerships", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/journal", "destination": "/index.html" },
    { "source": "/sitemap.xml", "destination": "/api/site/sitemap" },
    { "source": "/robots.txt", "destination": "/api/site/robots" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' https://images.unsplash.com data:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'" }
      ]
    }
  ]
}
